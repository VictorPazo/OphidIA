<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- 🔌 HTTP EM TEXTO PURO, SÓ NO BUILD DE DEPURAÇÃO
         O manifesto principal não permite mais http:// sem TLS, porque em
         produção o app fala com o servidor na nuvem, que é https.

         Mas o desenvolvimento continua usando o servidor local em
         http://localhost:8000 (com adb reverse) ou no IP da rede. Sem esta
         permissão o Android bloquearia essas chamadas em silêncio, e o app
         pareceria travado sem dar erro nenhum.

         Como vale apenas para o build de depuração, o APK de release
         continua sem a brecha. -->
    <application android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
